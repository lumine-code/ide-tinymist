{
  "name": "ide-tinymist",
  "author": "lumine-code",
  "description": "Tinymist language-server adapter for Typst.",
  "repository": "https://github.com/lumine-code/ide-tinymist",
  "bugs": {
    "url": "https://github.com/lumine-code/ide-tinymist/issues"
  },
  "keywords": [
    "language-server",
    "lsp",
    "typst",
    "typesetting",
    "intellisense"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "cd ../../lumine && npm run test:only -- ../pkg_lumine/ide-tinymist/spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "ide-client": {
      "versions": {
        "^1.0.0": "consumeIdeClient"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  },
  "configSchema": {
    "serverPath": {
      "title": "Server Path",
      "description": "Absolute path to a `tinymist` executable. Leave empty to look it up on PATH.",
      "type": "string",
      "default": ""
    }
  }
}
